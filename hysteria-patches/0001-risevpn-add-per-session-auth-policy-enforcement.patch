+func copyBufferLog(dst io.Writer, src io.Reader, log func(n uint64) bool, limiter *rate.Limiter) error {
 	bufp := copyBufPool.Get().(*[]byte)
 	buf := *bufp
 	defer copyBufPool.Put(bufp)
@@ -24,6 +27,11 @@ func copyBufferLog(dst io.Writer, src io.Reader, log func(n uint64) bool) error
