-func copyTwoWayEx(id string, serverRw, remoteRw io.ReadWriter, l TrafficLogger, stats *StreamStats) error {
+func copyTwoWayEx(id string, serverRw, remoteRw io.ReadWriter, l TrafficLogger, stats *StreamStats, up, down *rate.Limiter) error {
 	errChan := make(chan error, 2)
 	go func() {
 		errChan <- copyBufferLog(serverRw, remoteRw, func(n uint64) bool {
 			stats.LastActiveTime.Store(time.Now())
 			stats.Rx.Add(n)
 			return l.LogTraffic(id, 0, n)
-		})
+		}, down)
 	}()
 	go func() {
 		errChan <- copyBufferLog(remoteRw, serverRw, func(n uint64) bool {
 			stats.LastActiveTime.Store(time.Now())
 			stats.Tx.Add(n)
 			return l.LogTraffic(id, n, 0)
-		})
+		}, up)
 	}()
 	// Block until one of the two goroutines returns
 	return <-errChan
@@ -78,3 +86,10 @@ func copyTwoWay(serverRw, remoteRw io.ReadWriter) error {
 	// Block until one of the two goroutines returns
 	return <-errChan
 }
+
+func copyTwoWayLimited(serverRw, remoteRw io.ReadWriter, up, down *rate.Limiter) error {
+	errChan := make(chan error, 2)
+	go func() { errChan <- copyBufferLog(serverRw, remoteRw, func(uint64) bool { return true }, down) }()
+	go func() { errChan <- copyBufferLog(remoteRw, serverRw, func(uint64) bool { return true }, up) }()
+	return <-errChan
+}
