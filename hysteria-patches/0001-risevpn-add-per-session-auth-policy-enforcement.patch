Subject: [PATCH] risevpn: add per-session auth policy enforcement

---
 core/server/config.go         | 16 +++++++++++
 core/server/copy.go           | 23 ++++++++++++---
 core/server/server.go         | 54 +++++++++++++++++++++++++++++++----
 core/server/session_policy.go | 53 ++++++++++++++++++++++++++++++++++
 extras/auth/http.go           | 33 ++++++++++++++++++---
 5 files changed, 165 insertions(+), 14 deletions(-)
 create mode 100644 core/server/session_policy.go

diff --git a/core/server/config.go b/core/server/config.go
index 32c3ffd..7d62123 100644
--- a/core/server/config.go
+++ b/core/server/config.go
@@ -221,6 +221,22 @@ type Authenticator interface {
 	Authenticate(addr net.Addr, auth string, tx uint64) (ok bool, id string)
 }
 
+// SessionPolicy contains optional per-authenticated-session controls. Values of
+// zero inherit the server-wide setting. This extension deliberately leaves the
+// Hysteria wire protocol unchanged.
+type SessionPolicy struct {
+	MaxTx      uint64 // server to client, bytes per second
+	MaxRx      uint64 // client to server, bytes per second
+	Priority   uint8
+	P2PAllowed bool
+}
+
+// PolicyAuthenticator is an optional extension implemented by authenticators
+// that can return a policy together with the normal auth decision.
+type PolicyAuthenticator interface {
+	AuthenticateWithPolicy(addr net.Addr, auth string, tx uint64) (ok bool, id string, policy SessionPolicy)
+}
+
 // EventLogger is an interface that provides logging logic.
 type EventLogger interface {
 	Connect(addr net.Addr, id string, tx uint64)
