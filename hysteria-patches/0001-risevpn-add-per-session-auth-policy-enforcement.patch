diff --git a/core/server/session_policy.go b/core/server/session_policy.go
new file mode 100644
index 0000000..d444542
--- /dev/null
+++ b/core/server/session_policy.go
@@ -0,0 +1,53 @@
+package server
+
+import (
+	"errors"
+	"net"
+	"strconv"
+	"strings"
+
+	"golang.org/x/time/rate"
+)
+
+var errP2PBlocked = errors.New("peer-to-peer traffic is disabled for this session")
+
+func authenticateWithPolicy(a Authenticator, addr net.Addr, auth string, tx uint64) (bool, string, SessionPolicy) {
+	if policyAuth, ok := a.(PolicyAuthenticator); ok {
+		return policyAuth.AuthenticateWithPolicy(addr, auth, tx)
+	}
+	ok, id := a.Authenticate(addr, auth, tx)
+	return ok, id, SessionPolicy{P2PAllowed: true}
+}
+
+func newSessionLimiter(bytesPerSecond uint64) *rate.Limiter {
+	if bytesPerSecond == 0 {
+		return nil
+	}
+	burst := int(bytesPerSecond)
+	if burst > 64*1024 {
+		burst = 64 * 1024
+	}
+	if burst < 1500 {
+		burst = 1500
+	}
+	return rate.NewLimiter(rate.Limit(bytesPerSecond), burst)
+}
+
+func isP2PAddress(address string) bool {
+	host, portText, err := net.SplitHostPort(address)
+	if err != nil {
+		host = address
+	}
+	host = strings.ToLower(strings.TrimSuffix(host, "."))
+	if strings.Contains(host, "tracker") || strings.Contains(host, "announce") {
+		return true
+	}
+	port, _ := strconv.Atoi(portText)
+	return (port >= 6881 && port <= 6889) || port == 51413 || port == 6969
+}
+
+func isP2PPayload(data []byte) bool {
+	text := string(data)
+	return strings.HasPrefix(text, "\x13BitTorrent protocol") ||
+		strings.Contains(text, "announce_peer") || strings.Contains(text, "find_node")
+}
