#!/bin/sh
set -eu

BIN=/usr/local/lib/risevpn/risevpn-node-bin
CONFIG=/etc/risevpn/node.conf

case "${1:-}" in
  logs)
    shift
    exec journalctl -u risevpn-node.service -u risevpn-hysteria.service -u risevpn-xray.service "$@"
    ;;
  reenroll)
    shift
    "$BIN" enrollment reenroll --config "$CONFIG" "$@"
    systemctl restart risevpn-node.service
    ;;
  uninstall)
    shift
    purge=false
    if [ "${1:-}" = "--purge-data" ]; then purge=true; shift; fi
    [ "$#" -eq 0 ] || { echo "unexpected uninstall arguments" >&2; exit 2; }
    systemctl disable --now risevpn-xray.service risevpn-hysteria.service risevpn-node.service || true
    rm -f /etc/systemd/system/risevpn-xray.service /etc/systemd/system/risevpn-hysteria.service /etc/systemd/system/risevpn-node.service
    rm -f /usr/local/bin/risevpn-node /usr/local/lib/risevpn/risevpn-node-bin /usr/local/lib/risevpn/hysteria /usr/local/lib/risevpn/xray
    systemctl daemon-reload
    if [ "$purge" = true ]; then
      rm -f /etc/risevpn/node.conf /etc/risevpn/hysteria.yaml /etc/risevpn/xray.json /etc/risevpn/domain
      rm -f /etc/risevpn/tls/fullchain.pem /etc/risevpn/tls/privkey.pem
      rm -f /var/lib/risevpn/node.db /var/lib/risevpn/node.db-shm /var/lib/risevpn/node.db-wal
      echo "RiseVPN configuration and node identity were permanently removed."
    else
      echo "Binaries removed; /etc/risevpn and /var/lib/risevpn were preserved."
    fi
    ;;
  update)
    shift
    domain=$(sed -n 's/^domain=//p' "$CONFIG")
    email=$(sed -n 's/^acme_email=//p' "$CONFIG")
    origin=$(sed -n 's/^masquerade_url=//p' "$CONFIG")
    release_key=$(sed -n 's/^release_public_key=//p' "$CONFIG")
    proxied=
    if grep -q '^xray_transport=ws-tls$' "$CONFIG"; then proxied=--allow-proxied-domain; fi
    exec /usr/local/lib/risevpn/install.sh --upgrade $proxied --domain "$domain" --acme-email "$email" --masquerade-url "$origin" --release-public-key "$release_key" "$@"
    ;;
  serve)
    exec "$BIN" "$@"
    ;;
  status|doctor|device|enrollment|version)
    exec "$BIN" "$@" --config "$CONFIG"
    ;;
  *)
    echo "usage: risevpn-node <status|doctor|logs|reenroll|update|uninstall|device|version>" >&2
    exit 2
    ;;
esac
