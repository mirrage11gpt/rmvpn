FROM node:24-alpine AS web
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm run build

FROM golang:1.26-alpine AS go
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/webembed/dist/ ./webembed/dist/
RUN CGO_ENABLED=0 go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=0.2.0" -o /out/risevpn-control ./cmd/risevpn-control

FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata openssl su-exec && addgroup -S risevpn && adduser -S -G risevpn risevpn
COPY --from=go /out/risevpn-control /usr/local/bin/risevpn-control
COPY deploy/control-entrypoint.sh /usr/local/bin/control-entrypoint
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/control-entrypoint"]
