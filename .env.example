PUBLIC_DOMAIN=risevpn.example
CONTROL_DOMAIN=control.risevpn.example
ACME_EMAIL=admin@example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# All values below are base64url without padding. Generate 32 random bytes for symmetric keys.
SESSION_SECRET=
ENCRYPTION_KEY=
HWID_HMAC_KEY=
# Ed25519 private keys are 64 raw bytes encoded as base64url.
QUOTA_ED25519_PRIVATE_KEY=
COMPLIANCE_ED25519_PRIVATE_KEY=
HYSTERIA_OBFS_PASSWORD=
RESTIC_REPOSITORY=s3:https://storage.example/risevpn-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_REGION=ru-central1
